{
  "read_only": false,
  "skip_permissions": false,
  "identity_action": "add",
  "default_identity": "work",
  "identities": [
    {
      "name": "work",
      "from_addr": "paris@example.org",
      "from_name": "Paris",
      "driver": "ssh_sendmail",
      "host": "lxplus.example.org",
      "user": "paris",
      "socket": "~/.ssh/email-mcp-sock"
    },
    {
      "name": "gmail",
      "from_addr": "paris.gmail@example.org",
      "driver": "smtp",
      "host": "smtp.example.org",
      "port": 587,
      "keychain": "email-mcp-gmail"
    }
  ],
  "install_dispatcher": true,
  "install_fts_agent": false,
  "fts_choice": "defer",
  "fts_limit": 500,
  "self_send": false
}
